    {
      "name": "Public Search",
      "item": [
        {
          "name": "Search by Coordinates",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 42.3601,\n  \"longitude\": -71.0589,\n  \"radius_miles\": 10,\n  \"services\": [\"pickup\"],\n  \"store_types\": [\"regular\"],\n  \"open_now\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stores/search",
              "host": ["{{base_url}}"],
              "path": ["api", "stores", "search"]
            }
          }
        },
        {
          "name": "Search by ZIP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"postal_code\": \"02101\",\n  \"radius_miles\": 10\n}" },
            "url": { "raw": "{{base_url}}/api/stores/search", "host": ["{{base_url}}"], "path": ["api", "stores", "search"] }
          }
        },
        {
          "name": "Search by Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"1 Main St, Boston, MA\",\n  \"radius_miles\": 10\n}" },
            "url": { "raw": "{{base_url}}/api/stores/search", "host": ["{{base_url}}"], "path": ["api", "stores", "search"] }
          }
        },
        {
          "name": "Search Combined Filters (radius + services AND + store_types OR)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 42.3601,\n  \"longitude\": -71.0589,\n  \"radius_miles\": 10,\n  \"services\": [\"pickup\", \"pharmacy\"],\n  \"store_types\": [\"regular\", \"outlet\"],\n  \"open_now\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/stores/search",
              "host": ["{{base_url}}"],
              "path": ["api", "stores", "search"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var body = pm.response.json();",
                  "var req = JSON.parse(pm.request.body.raw);",
                  "var radius = req.radius_miles;",
                  "var required = req.services || [];",
                  "var allowedTypes = (req.store_types || []).map(function (t) { return String(t); });",
                  "function normTypes(arr) {",
                  "  return (arr || []).map(function (t) { return String(t); });",
                  "}",
                  "pm.test('Shape: total, filters, results', function () {",
                  "  pm.expect(body).to.have.keys('total', 'filters', 'results', 'search_latitude', 'search_longitude');",
                  "  pm.expect(body.total).to.eql(body.results.length);",
                  "});",
                  "pm.test('Filters echo request', function () {",
                  "  pm.expect(body.filters.radius_miles).to.eql(radius);",
                  "  pm.expect(body.filters.services).to.eql(required);",
                  "  pm.expect(normTypes(body.filters.store_types)).to.eql(allowedTypes);",
                  "  pm.expect(body.filters.open_now).to.eql(req.open_now);",
                  "});",
                  "pm.test('Each row satisfies combined rules', function () {",
                  "  body.results.forEach(function (row) {",
                  "    pm.expect(row.distance_miles, 'distance within radius').to.be.at.most(radius);",
                  "    pm.expect(allowedTypes, 'store_type in OR list').to.include(String(row.store_type));",
                  "    required.forEach(function (svc) {",
                  "      pm.expect(row.services, 'service AND: ' + svc).to.include(svc);",
                  "    });",
                  "    if (req.open_now === true) {",
                  "      pm.expect(row.is_open_now, 'open_now filter').to.be.true;",
                  "    }",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Negative - Missing Search Inputs",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
